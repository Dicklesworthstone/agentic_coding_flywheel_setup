#!/usr/bin/env bash
# ACFS Pre-commit Hook: Auto-regenerate manifest outputs
#
# When acfs.manifest.yaml or packages/manifest/** change,
# this hook regenerates all manifest-derived outputs and stages the changes.
#
# Install: ./scripts/hooks/install.sh
# Bypass: git commit --no-verify
# CI enforces: bun run generate --diff (blocks merge on drift)

set -euo pipefail

# Check if manifest-related files are staged
if git diff --cached --name-only | grep -qE '^(acfs\.manifest\.yaml|packages/manifest/)'; then
    echo "📦 Manifest changes detected, regenerating manifest-derived outputs..."

    # Check if bun is available
    if ! command -v bun &>/dev/null; then
        echo "⚠️  bun not found. Skipping auto-regeneration."
        echo "   Run manually: cd packages/manifest && bun run generate"
        exit 0
    fi

    # Regenerate
    (cd packages/manifest && bun install --silent && bun run generate) || {
        echo "❌ Generator failed. Fix issues before committing."
        exit 1
    }

    # Stage regenerated files (tracked only, plus new generator outputs; never
    # stray untracked files another agent left in these shared directories)
    git add -u scripts/generated/
    while IFS= read -r generated_file; do
        [[ "$generated_file" == scripts/generated/*.sh ]] || continue
        git add -- "$generated_file"
    done < <(git ls-files --others --exclude-standard -- scripts/generated 2>/dev/null)
    if [[ -d apps/web/lib/generated ]]; then
        git add -u apps/web/lib/generated/
        while IFS= read -r generated_file; do
            [[ "$generated_file" == apps/web/lib/generated/*.ts ]] || continue
            git add -- "$generated_file"
        done < <(git ls-files --others --exclude-standard -- apps/web/lib/generated 2>/dev/null)
        echo "✅ Regenerated and staged scripts/generated/ and apps/web/lib/generated/"
    else
        echo "✅ Regenerated and staged scripts/generated/"
    fi
fi
