#!/usr/bin/env bash
# ACFS Pre-commit Hook: Auto-regenerate manifest outputs
#
# When acfs.manifest.yaml or packages/manifest/** change,
# this hook regenerates all manifest-derived outputs and stages the changes.
#
# Install: ./scripts/hooks/install.sh
# Bypass: git commit --no-verify
# CI enforces: bun run generate --diff (blocks merge on drift)

set -euo pipefail

# Check if manifest-related files are staged
if git diff --cached --name-only | grep -qE '^(acfs\.manifest\.yaml|packages/manifest/)'; then
    echo "📦 Manifest changes detected, regenerating manifest-derived outputs..."

    # Check if bun is available
    if ! command -v bun &>/dev/null; then
        echo "⚠️  bun not found. Skipping auto-regeneration."
        echo "   Run manually: cd packages/manifest && bun run generate"
        exit 0
    fi

    # Regenerate
    (cd packages/manifest && bun install --silent && bun run generate) || {
        echo "❌ Generator failed. Fix issues before committing."
        exit 1
    }

    # Stage regenerated files (tracked only, plus new generator outputs; never
    # stray untracked files another agent left in these shared directories)
    git add -u scripts/generated/
    while IFS= read -r generated_file; do
        [[ "$generated_file" == scripts/generated/*.sh ]] || continue
        git add -- "$generated_file"
    done < <(git ls-files --others --exclude-standard -- scripts/generated 2>/dev/null)
    if [[ -d apps/web/lib/generated ]]; then
        git add -u apps/web/lib/generated/
        while IFS= read -r generated_file; do
            [[ "$generated_file" == apps/web/lib/generated/*.ts ]] || continue
            git add -- "$generated_file"
        done < <(git ls-files --others --exclude-standard -- apps/web/lib/generated 2>/dev/null)
        echo "✅ Regenerated and staged scripts/generated/ and apps/web/lib/generated/"
    else
        echo "✅ Regenerated and staged scripts/generated/"
    fi
fi

# ---------------------------------------------------------------------------
# Internal checksum ledger guard
#
# scripts/generated/internal_checksums.sh pins the SHA256 of 113 runtime files.
# install.sh verifies every one of them before it will run, so a commit that
# changes a covered file without regenerating the ledger breaks `curl | bash`
# for every new user until someone happens to regenerate.
#
# The manifest check above does not catch this: it only fires on
# acfs.manifest.yaml and packages/manifest/**, while the ledger covers
# scripts/lib/**, packages/onboard/**, install.sh and friends. Editing
# scripts/lib/support.sh triggers nothing today.
#
# This guard detects drift without running the generator. A pre-commit hook
# must validate the index, not regenerate from the working tree: partial
# staging could otherwise make the committed ledger hash bytes that are not in
# the commit.
# ---------------------------------------------------------------------------

LEDGER_PATH="scripts/generated/internal_checksums.sh"

acfs_sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum | cut -d' ' -f1
    else
        shasum -a 256 | cut -d' ' -f1
    fi
}

ledger_is_staged=false
if git diff --cached --name-only | grep -qxF "$LEDGER_PATH"; then
    ledger_is_staged=true
fi

# Read ledger keys and expected hashes from the staged ledger when it is staged,
# otherwise from HEAD's copy. Never read an unstaged working-tree ledger here.
acfs_ledger_stream() {
    if [[ "$ledger_is_staged" == "true" ]]; then
        git show ":$LEDGER_PATH" 2>/dev/null
    else
        git show "HEAD:$LEDGER_PATH" 2>/dev/null
    fi
}

acfs_ledger_expected_hash() {
    local target_path="$1"
    printf '%s\n' "$ledger_data" | awk -v target="$target_path" '
        {
            line = $0
            sub(/^[[:space:]]*/, "", line)
            prefix = "[" target "]=\""
            if (index(line, prefix) == 1) {
                hash = substr(line, length(prefix) + 1)
                sub(/\"$/, "", hash)
                if (length(hash) == 64 && hash ~ /^[0-9a-f]+$/) {
                    print hash
                    exit
                }
            }
        }
    '
}

if ledger_data="$(acfs_ledger_stream)" && [[ -n "$ledger_data" ]]; then
    ledger_declared_count="$(printf '%s\n' "$ledger_data" | awk -F= '
        $1 == "ACFS_INTERNAL_CHECKSUMS_COUNT" && $2 ~ /^[0-9]+$/ { print $2; exit }
    ')"
    ledger_parsed_count="$(printf '%s\n' "$ledger_data" | awk '
        /^[[:space:]]*\[[^]]+\]="[0-9a-f]{64}"$/ { count += 1 }
        END { print count + 0 }
    ')"
    ledger_unique_count="$(printf '%s\n' "$ledger_data" | awk '
        /^[[:space:]]*\[[^]]+\]="[0-9a-f]{64}"$/ {
            line = $0
            sub(/^[[:space:]]*\[/, "", line)
            sub(/\]="[0-9a-f]{64}"$/, "", line)
            seen[line] = 1
        }
        END {
            for (line in seen) count += 1
            print count + 0
        }
    ')"
    if [[ -z "$ledger_declared_count" ]] \
        || [[ "$ledger_parsed_count" -ne "$ledger_declared_count" ]] \
        || [[ "$ledger_unique_count" -ne "$ledger_parsed_count" ]]; then
        echo "❌ Internal checksum ledger structure is malformed:"
        echo "   declared=${ledger_declared_count:-missing} parsed=$ledger_parsed_count unique=$ledger_unique_count"
        echo "   Run:  cd packages/manifest && bun run generate"
        exit 1
    fi

    # Membership: every ledger entry must be reachable by install.sh's bootstrap
    # extraction. A key outside those patterns can never be present in the
    # unpacked archive, which surfaces to users as "INTEGRITY: <path> missing"
    # -- a structurally different failure from a stale hash, and one no amount
    # of regenerating will fix.
    unreachable=""
    while IFS= read -r key; do
        case "$key" in
            scripts/*|packages/onboard/*|acfs/*) ;;
            install.sh|checksums.yaml|acfs.manifest.yaml|VERSION) ;;
            *) unreachable="${unreachable}  $key"$'\n' ;;
        esac
    done < <(printf '%s\n' "$ledger_data" | grep -oE '^[[:space:]]*\[[^]]+\]=' | sed 's/^[[:space:]]*\[//; s/\]=$//')

    if [[ -n "$unreachable" ]]; then
        echo "❌ Internal checksum ledger covers files the bootstrap archive never extracts:"
        printf '%s' "$unreachable"
        echo "   install.sh unpacks only: scripts/** packages/onboard/** acfs/**"
        echo "                            install.sh checksums.yaml acfs.manifest.yaml VERSION"
        echo "   Either add the path to the extraction list in install.sh, or drop it"
        echo "   from the ledger. Users would otherwise see 'INTEGRITY: <path> missing'."
        exit 1
    fi

    # Track unstaged covered changes. If the staged commit also changes the
    # ledger or needs a regeneration, generating from the working tree would
    # mix two snapshots and create a self-inconsistent commit.
    unstaged_covered=""
    while IFS= read -r unstaged; do
        [[ -n "$unstaged" ]] || continue
        expected="$(acfs_ledger_expected_hash "$unstaged" || true)"
        [[ -n "$expected" ]] || continue
        unstaged_covered="${unstaged_covered}  $unstaged"$'\n'
    done < <(git diff --name-only --diff-filter=ACMRD)

    # Drift: when the ledger is staged, validate every entry against the
    # candidate commit (the index). This catches ledger-only hash corruption,
    # not just covered files that also happen to be staged. Otherwise, checking
    # the staged covered paths is sufficient because HEAD's ledger is trusted.
    drifted=""
    staged_deletions=""
    if [[ "$ledger_is_staged" == "true" ]]; then
        candidate_paths="$(printf '%s\n' "$ledger_data" | grep -oE '^[[:space:]]*\[[^]]+\]=' | sed 's/^[[:space:]]*\[//; s/\]=$//')"
    else
        candidate_paths="$(git diff --cached --name-only --diff-filter=ACMRD)"
    fi
    while IFS= read -r staged; do
        [[ -n "$staged" ]] || continue
        expected="$(acfs_ledger_expected_hash "$staged" || true)"
        [[ -n "$expected" ]] || continue          # not a covered file
        if ! actual="$(git show ":$staged" 2>/dev/null | acfs_sha256)"; then
            staged_deletions="${staged_deletions}  $staged"$'\n'
            continue
        fi
        [[ "$actual" == "$expected" ]] || drifted="${drifted}  $staged"$'\n'
    done <<< "$candidate_paths"

    if [[ -n "$staged_deletions" ]]; then
        echo "❌ Checksum-covered files are staged for deletion:"
        printf '%s' "$staged_deletions"
        echo "   Update the generator/archive contract explicitly before removing a covered file."
        exit 1
    fi

    if [[ -n "$unstaged_covered" ]] \
        && { [[ "$ledger_is_staged" == "true" ]] || [[ -n "$drifted" ]]; }; then
        echo "❌ Cannot verify the checksum ledger with unstaged covered changes:"
        printf '%s' "$unstaged_covered"
        echo "   The generator reads working-tree bytes, while this commit contains index bytes."
        echo "   Stage the complete covered change set or otherwise resolve those files,"
        echo "   then run: cd packages/manifest && bun run generate"
        exit 1
    fi

    if [[ -n "$drifted" ]]; then
        echo "❌ Checksum-covered files changed without a ledger regeneration:"
        printf '%s' "$drifted"
        echo "   Run:  cd packages/manifest && bun run generate"
        echo "   Then review and stage the coherent generated output before committing."
        exit 1
    fi
fi
